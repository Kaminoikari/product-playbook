{
  "name": "product-playbook",
  "version": "2.3.0",
  "description": "MUST use when the user wants to plan, strategize, validate, or scope a product or feature. Composable product-thinking lenses (JTBD, PR-FAQ, positioning, pre-mortem, RICE, North Star, MVP, GTM, and more) that snap to the outcome and blend when the situation needs it, from raw idea to dev handoff.",
  "bin": {
    "product-playbook": "./install.sh"
  },
  "scripts": {
    "eval": "npm run eval:trigger && npm run eval:behavioral",
    "eval:trigger": "python3 evals/run_trigger_test.py --runs 3 --workers 4 --fail-on critical",
    "eval:behavioral": "python3 evals/run_behavioral_eval.py --runs 3 --workers 2 --fail-on critical",
    "eval:quick": "python3 evals/run_behavioral_eval.py --runs 1 --workers 2 --fail-on critical",
    "eval:test": "python3 -m unittest evals.test_compute_eval_score",
    "eval:debt": "python3 scripts/eval-debt-report.py",
    "eval:lift": "python3 scripts/eval-lift-report.py",
    "eval:patch": "python3 scripts/patch-proposer.py",
    "eval:attribution": "python3 scripts/attribution-check.py",
    "loop:tick": "python3 scripts/loop-tick.py",
    "loop:summary": "python3 scripts/loop-summary.py",
    "loop:status": "python3 scripts/loop-status.py",
    "loop:prune": "python3 scripts/loop-history-prune.py",
    "loop:suppress": "python3 scripts/suppress-pair.py",
    "test:closed-loop": "python3 -m unittest tests/test_closed_loop.py -v",
    "test:install-smoke": "python3 -m unittest tests/test_install_smoke.py -v",
    "test:all": "python3 -m unittest discover tests -v",
    "bundle:claude-ai": "bash scripts/build-claude-ai-bundle.sh"
  },
  "keywords": [
    "claude",
    "claude-code",
    "product",
    "pm",
    "skill",
    "framework",
    "product-management",
    "planning"
  ],
  "author": "Charles Chen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaminoikari/product-playbook.git"
  },
  "bugs": {
    "url": "https://github.com/kaminoikari/product-playbook/issues"
  },
  "homepage": "https://github.com/kaminoikari/product-playbook#readme",
  "files": [
    ".claude-plugin/",
    "skills/",
    "install.sh",
    "agents/",
    "hooks/",
    "references/",
    "LICENSE"
  ]
}
